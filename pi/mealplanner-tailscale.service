[Unit]
Description=Publish Meal Planner to the tailnet
# tailscaled may not exist at all (Tailscale is optional); After= on a unit
# that is not installed is simply ignored, and the script exits cleanly.
After=tailscaled.service network-online.target meal-planner.service
Wants=network-online.target

[Service]
Type=oneshot
# Invoked through bash so a lost execute bit (a FAT copy, a zip round-trip)
# cannot stop the Pi publishing itself.
ExecStart=/bin/bash __APP_DIR__/pi/setup-tailscale.sh
# The script waits up to a minute for tailscaled to finish connecting.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
