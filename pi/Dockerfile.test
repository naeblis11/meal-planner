# Test-only image: a Debian Bookworm user account, like Raspberry Pi OS,
# with the repo copied in. Used by pi/test-in-docker.ps1; not for running
# the app for real (the Pi runs it directly, no containers).
FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        python3 python3-venv python3-pip libjpeg62-turbo sudo curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash pi && echo 'pi ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/pi
WORKDIR /home/pi/Meal_Planner
COPY . .
# The scripts must be LF and executable regardless of how Windows checked
# them out; then hand the whole tree to the pi user, as a git clone would.
RUN sed -i 's/\r$//' pi/*.sh && chmod +x pi/*.sh && chown -R pi:pi /home/pi/Meal_Planner
USER pi
CMD ["bash", "pi/smoke.sh"]
