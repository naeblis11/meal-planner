<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission, on purpose: the app never sends anything anywhere.
     The tools:node="remove" line below enforces that: if a library ever merges
     the permission in, the manifest merger strips it back out.
     The only permissions are the two calendar ones: "Send this week" writes events
     into a calendar on this phone through CalendarContract, and Android's own sync
     carries them on. They are asked for when the user sets up calendar sending.
     allowBackup is off because Android's own backup would copy the library to
     the cloud; the user's backup is the zip they export. On Android 12+ a phone-to-phone
     transfer ignores allowBackup, so dataExtractionRules keeps the database (whose
     calendar_event ids only mean something on this phone) and the calendar choice out
     of both cloud backup and device transfer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".app.MealPlannerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write the photo it takes into our cache; not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
