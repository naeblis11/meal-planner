# Template for the app's secrets file. The real file is NOT in this folder:
# it lives at  %LOCALAPPDATA%\Meal Planner\.env  on Windows
# (or ~/.config/meal-planner/.env elsewhere). The installer (configure.py) writes it
# for you, and so does `python set_password.py`; set MEAL_PLANNER_HOME to relocate the whole directory.

# Random 64-hex-char key used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MEAL_PLANNER_SECRET_KEY=

# scrypt hash of the household password, as produced by set_password.py.
# The plain password is never stored anywhere.
MEAL_PLANNER_PASSWORD_HASH=

# Optional. Default 127.0.0.1 = this computer only. Set to 0.0.0.0 to
# reach the app from a phone on the home Wi-Fi (the login gate applies).
# MEAL_PLANNER_HOST=0.0.0.0

# Optional. Set to 1 when an HTTPS reverse proxy sits in front of the app
# (Tailscale Serve, Caddy, nginx...). The app then trusts one hop of
# X-Forwarded-* headers so redirects, https detection and Secure cookies
# are right. Leave unset on a plain LAN install: any client could forge
# those headers. See docs/REMOTE-ACCESS.md.
# MEAL_PLANNER_BEHIND_PROXY=1

# Optional. Token Home Assistant presents to the /api/voice/* endpoints
# used by the Alexa skill. `python set_api_token.py` generates it; with
# no token the voice endpoints are switched off (503). The same token
# guards /api/ha/* (the shopping-list mirror's webhook).
# MEAL_PLANNER_API_TOKEN=

# Optional. Mirror the shopping list into a Home Assistant to-do list so
# it can be used from the HA companion app anywhere (ha/SETUP-SHOPPING.md).
# `python set_ha_link.py` fills these in after proving the link. All
# three unset = no mirror.
# MEAL_PLANNER_HA_URL=http://homeassistant.local:8123
# MEAL_PLANNER_HA_TOKEN=
# MEAL_PLANNER_HA_TODO_ENTITY=todo.shopping_list
