# Release signing for the Android app. Copy to apps/keystore.properties (git-ignored),
# or let the command in docs/ANDROID.md ("Building a signed release") write it for you.
# The keystore itself lives outside the repo, in %LOCALAPPDATA%\Meal Planner\.
# Use forward slashes in storeFile. Never commit the real file or the keystore.
storeFile=C:/Users/<you>/AppData/Local/Meal Planner/android-release.jks
storePassword=<the keystore password>
keyAlias=meal-planner
keyPassword=<the same password>
