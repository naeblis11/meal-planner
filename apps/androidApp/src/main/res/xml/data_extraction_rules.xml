<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ copies app data to a new phone even with allowBackup off. The database
     must not travel: calendar_event holds this phone's calendar row ids, which on another
     phone could name the family's own events. The calendar choice (SharedPreferences file
     "calendar", CalendarChoice.FILE) is such an id too. The user's backup is the zip they
     export from Settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="calendar.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="calendar.xml" />
    </device-transfer>
</data-extraction-rules>
