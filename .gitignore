# Local app database - rebuilt from recipes/*.yaml via sync
*.zip
*.db
*.db-journal
*.db-wal
*.db-shm
.import_staging.json
.correction_staging.json

# Secrets: session key + password hash (see .env.example)
.env

__pycache__/
*.pyc
*.log

# Subagent-driven-development scratch workspaces
/.superpowers/

# Impeccable design-hook session cache - ephemeral, not project source
.impeccable/hook.cache.json

# Google service account keys. A downloaded key is named after the Cloud
# project, so it looks like an ordinary data file -- and it is a live
# credential. One was committed here once; never again.
google-calendar-key.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*service-account*.json
*.iam.gserviceaccount.com.json

# The Google OAuth client built into the desktop app (docs/WINDOWS.md): the
# developer's own file naming it, and the resource the build writes from it.
apps/google-client.properties
google-client.json

# Python virtual environment (install.ps1 and pi/install.sh create it here)
.venv/

# Kotlin apps (apps/): build output, IDE state, machine-local SDK path,
# and release signing. A keystore signs every future update of the app, so
# it must never be committed -- or exported to the public repo.
# These four are path-independent on purpose: a leftover android/ folder
# (see below) holds the same files.
keystore.properties
local.properties
.gradle/
.kotlin/
*.jks
*.keystore
*.p12
*.pfx
apps/.idea/
apps/build/
apps/*/build/
apps/shared/*/build/

# Legacy pre-KMP location of the Android app. `git mv android apps` leaves
# the untracked files behind (keystore.properties, local.properties,
# .gradle/, build/) in the old checkout; keep them out of `git status`.
/android/
